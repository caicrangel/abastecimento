# MySQL
MYSQL_ROOT_PASSWORD=root_super_secret_change_me
MYSQL_DATABASE=abastecimento
MYSQL_USER=abastecimento
MYSQL_PASSWORD=abastecimento_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306

# App
APP_PORT=3000
SESSION_SECRET=mude_esta_chave_para_uma_string_aleatoria_com_pelo_menos_32_chars
NODE_ENV=production
# Defina como "true" SOMENTE se o app estiver atras de HTTPS (proxy reverso com SSL).
# Em HTTP puro, mantenha false ou o cookie de sessao nao sera enviado pelo browser.
COOKIE_SECURE=false

# Usuario admin inicial (criado no primeiro start se nao existir)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOME=Administrador
