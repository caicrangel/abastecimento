# Caddyfile - HTTPS reverse proxy para o app
# Copie para caddy/Caddyfile e ajuste conforme o cenario.

# Bloqueia HTTP/3 (que tem buffer insuficiente em algumas VPS) e
# desabilita o auto-https do Caddy (vamos gerenciar o cert manualmente).
{
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

# ====================================================================
# Cenario 1 (recomendado para IP local): cert self-signed gerado com openssl
# Veja README, secao "HTTPS local", para o comando de geracao.
# Funciona em https://SEU_IP/ (aceitar o aviso "Continuar mesmo assim").
# ====================================================================
:443 {
    tls /certs/fullchain.crt /certs/privkey.key
    reverse_proxy app:3000
}

# ====================================================================
# Cenario 2: cert valido emitido para um dominio (Let's Encrypt, CA da empresa, etc.)
# Comente o bloco ':443' acima e use este, substituindo o dominio.
# ====================================================================
# abastecimento.suaempresa.com.br {
#     tls /certs/fullchain.crt /certs/privkey.key
#     reverse_proxy app:3000
# }

# HTTP -> HTTPS
:80 {
    redir https://{host}{uri} permanent
}
